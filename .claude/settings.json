{
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5"
  },
  "enabledPlugins": {
    "founding-agents@founding-agents": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/check-on-stop.sh\"; [ ! -f \"$f\" ] || sh \"$f\"",
            "timeout": 120,
            "statusMessage": "Running ./check.sh"
          }
        ]
      }
    ]
  }
}
